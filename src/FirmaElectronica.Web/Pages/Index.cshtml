@page
@model IndexModel
@{ ViewData["Title"] = "Documentación digital"; }
<svg class="iconos" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><defs>
    <symbol id="i-firma" viewBox="0 0 24 24"><path d="M4 19c5-6 10-15 12-14 3 1-5 13-9 12-3-1 4-5 6-3s-2 5 1 4l6-3M4 21h16" /></symbol>
    <symbol id="i-documento" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h5" /></symbol>
    <symbol id="i-mas" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
    <symbol id="i-carpeta" viewBox="0 0 24 24"><path d="M3 7V5a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7h18" /></symbol>
    <symbol id="i-reloj" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></symbol>
    <symbol id="i-salir" viewBox="0 0 24 24"><path d="M9 4H5v16h4M9 12h12m-4-4 4 4-4 4" /></symbol>
    <symbol id="i-flecha" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5" /></symbol>
    <symbol id="i-buscar" viewBox="0 0 24 24"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></symbol>
    <symbol id="i-ojo" viewBox="0 0 24 24"><path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" /></symbol>
    <symbol id="i-enviar" viewBox="0 0 24 24"><path d="m21 3-7 18-4-7-7-4 18-7ZM10 14 21 3" /></symbol>
    <symbol id="i-borrar" viewBox="0 0 24 24"><path d="M3 6h18M9 6V3h6v3M5 6l1 15h12l1-15M10 10v7M14 10v7" /></symbol>
    <symbol id="i-check" viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></symbol>
    <symbol id="i-cerrar" viewBox="0 0 24 24"><path d="m6 6 12 12M6 18 18 6" /></symbol>
    <symbol id="i-refresh" viewBox="0 0 24 24"><path d="M20 7v5h-5M4 17v-5h5M5 7a8 8 0 0 1 13-2l2 3M4 16l2 3a8 8 0 0 0 13-2" /></symbol>
</defs></svg>
<button type="button" id="cambiar-tema" class="boton secundario tema-control" aria-label="Activar modo oscuro">☾ Modo oscuro</button>
<div id="firma-app" data-demo-enabled="@Model.PermiteEjemplo.ToString().ToLowerInvariant()">
    <div id="inicio-carga" class="carga-inicial" role="status"><span class="marca-icono"><svg><use href="#i-firma" /></svg></span><p>Preparando Grupo Huerpel…</p></div>
    <section id="acceso" class="acceso" hidden aria-labelledby="titulo-acceso">
        <div class="acceso-presentacion">
            <a class="marca" href="~/"><span class="marca-icono"><svg><use href="#i-firma" /></svg></span><span>Firma Digital<span class="marca-sub">EXPEDIENITES DIGITALES</span></span></a>
            <div class="acceso-mensaje"><span class="eyebrow">GENERA EXPEDIENTES DIGITALES.</span><h1>Documentos Digitales,<br />Grupo Huerpel.</h1><p>Genera los documentos de tu agencia y gestiona cada expediente hasta su firma.</p>
                <div class="ilustracion" aria-hidden="true"><div class="hoja hoja-fondo"></div><div class="hoja"><span class="mini-marca">firma <span>EXPEDIENTE DIGITAL</span></span><span class="linea larga"></span><span class="linea media"></span><span class="linea"></span><div class="lineas-dobles"><span class="linea"></span><span class="linea"></span></div><svg class="firma-trazo"><use href="#i-firma" /></svg><div class="sello"><svg><use href="#i-check" /></svg>Documento firmado</div></div><span class="flotante"><svg><use href="#i-check" /></svg>Un paso más cerca</span></div>
            </div><p class="acceso-pie">Preparar <span>→</span> Generar <span>→</span> Firmar</p>
        </div>
        <div class="acceso-formulario"><div class="acceso-card"><img class="logo-huerpel" src="~/images/grupo-huerpel.jpg" asp-append-version="true" alt="Grupo Huerpel" width="128" height="101" /><span class="etiqueta">PLATAFORMA DE FIRMA DIGITAL</span><h2 id="titulo-acceso">Bienvenido de nuevo</h2><p class="muted">Ingresa con tu cuenta para continuar.</p>
            <form id="form-acceso"><label>Usuario<input name="usuario" autocomplete="username" required maxlength="100" placeholder="Tu usuario" /></label><label>Contraseña<span class="campo-password"><input id="contrasena" name="contrasena" type="password" autocomplete="current-password" required placeholder="Tu contraseña" /><button type="button" class="boton-icono" id="ver-contrasena" aria-label="Mostrar contraseña"><svg><use href="#i-ojo" /></svg></button></span></label><p id="error-acceso" class="error-texto" role="alert" hidden></p><button class="boton primario ancho" type="submit">Iniciar sesión <svg><use href="#i-flecha" /></svg></button></form>
            <p class="nota-acceso">Si olvidaste tu usuario y/o contraseña, contacta al equipo de Digitalización</p>
        </div><span class="version">Firma V2 · Grupo Huerpel</span></div>
    </section>
    <div id="espacio" class="espacio" hidden>
        <aside class="sidebar"><a class="marca" href="~/"><span class="marca-icono"><svg><use href="#i-firma" /></svg></span><span>Firma Digital<span class="marca-sub">EXPEDIENITES DIGITALES</span></span></a><span class="nav-titulo">Grupo Huerpel</span><nav aria-label="Navegación principal"><button data-vista="generar" class="nav-item activo" aria-current="page"><svg><use href="#i-mas" /></svg><span>Nuevo expediente</span></button><button data-vista="documentos" class="nav-item"><svg><use href="#i-carpeta" /></svg><span>Mis documentos</span></button><button data-vista="actividad" class="nav-item"><svg><use href="#i-reloj" /></svg><span>Actividad</span><span id="pendientes" class="contador" hidden>0</span></button></nav><div class="sidebar-pie"><span class="punto"></span><span>Firma electrónica<span class="muted bloque">Versión 2.0</span></span></div></aside>
        <div class="contenido"><header class="topbar"><span class="ruta">Grupo Huerpel <span>/</span> <strong id="ruta-actual">Generar expediente</strong></span><div class="cuenta"><span id="marca-ejemplo" class="badge aviso" hidden>Datos de ejemplo</span><span id="avatar" class="avatar">U</span><span class="usuario"><strong id="usuario-nombre"></strong><small id="usuario-rol"></small></span><button id="cerrar-sesion" class="boton-icono" aria-label="Cerrar sesión" title="Cerrar sesión"><svg><use href="#i-salir" /></svg></button></div></header>
            <div id="banner-ejemplo" class="banner-ejemplo" hidden><strong>Vista de prueba</strong><span>Los documentos y contactos son ficticios. Las acciones sólo afectan esta vista.</span><button id="salir-ejemplo" class="enlace">Ir al acceso real</button></div>
            <main id="principal" tabindex="-1">
                <div class="cabecera"><div><span class="eyebrow" id="sobre-titulo">UN EXPEDIENTE, PASO A PASO</span><h1 id="titulo-vista">Generar expediente</h1><p id="descripcion-vista" class="muted">Consulta una referencia y prepara su documentación.</p></div><label class="agencia-global">Agencia de trabajo<select id="agencia-global" aria-label="Agencia de trabajo"></select></label></div>
                <section id="vista-generar" aria-label="Generar expediente">
                    <ol class="pasos"><li class="actual"><span>1</span>Consultar referencia</li><li><span>2</span>Revisar los datos</li><li><span>3</span>Generar y convocar</li></ol>
                    <div class="panel consulta-panel"><div class="panel-titulo"><span class="icono-suave"><svg><use href="#i-buscar" /></svg></span><div><h2>Comienza con una referencia</h2><p class="muted">La referencia identifica automáticamente la agencia del expediente.</p></div></div><form id="form-referencia" class="consulta-form"><label>Referencia<input name="referencia" id="referencia" inputmode="numeric" pattern="[0-9]+" data-numerico required maxlength="50" placeholder="Ej. 22473390" autocomplete="off" /></label><label>Folio de control<input inputmode="numeric" pattern="[0-9]+" data-numerico id="folio-consulta" name="folioControl" maxlength="100" placeholder="No aplica para seminuevos" autocomplete="off" /></label><label>Tipo de venta<select name="tipoVenta" id="tipo-venta"><option value="">Tipo de Venta</option><option value="AFD">AFD - ACTIVO FIJO DISTRIBUIDOR</option><option value="CON">CON - CONTADO DISTRIBUIDOR - CLIENTE</option><option value="DEM">DEM - VEHICULO NUEVO PRUEBAS MANEJO</option><option value="LOC">LOC - LOAN CAR</option><option value="NMX">NMX - VENTA EMPLEADO NISSAN Y FILIAL</option><option value="PET">PET - UNIDADES SINIESTRADAS</option><option value="RCI">RCI - CREDITO CREDINISSAN</option><option value="SIC">SIC - SICREA SIN DESCUENTO VTA. CTE.</option><option value="TUA">TUA - TU AMIGO AL VOLANTE</option><option value="OTR">OTR - OTRA FINANCIERA</option></select></label><button type="submit" class="boton primario">Consultar referencia <svg><use href="#i-flecha" /></svg></button></form><p class="ayuda">Nuevos: captura el folio de control. Seminuevos: basta la referencia; el tipo de expediente se identifica al consultar.</p><p id="ayuda-ejemplo" class="ayuda" hidden>Para explorar, usa una referencia como <button type="button" class="enlace" id="usar-ejemplo">900001</button>.</p></div>
                    <div class="seccion-titulo"><div><h2>Expediente por preparar <span id="numero-referencias" class="numero">0</span></h2><p class="muted">Revisa la información antes de generar.</p></div><button id="generar-documentos" class="boton primario" disabled><svg><use href="#i-documento" /></svg>Generar expediente</button></div>
                    <div id="referencias-lista"></div><div id="referencias-vacias" class="vacio"><span class="vacio-icono"><svg><use href="#i-documento" /></svg></span><h3>Tu próximo expediente comienza aquí</h3><p>Consulta una referencia arriba. Podrás revisar el cliente,<br class="solo-escritorio" /> el vehículo y el seguro antes de generar.</p></div>
                    <div class="nota-inferior"><svg><use href="#i-check" /></svg>Incidencias, contacta al equipo de Digitalización.</div>
                </section>
                <section id="vista-documentos" hidden aria-label="Mis documentos"><form id="form-filtros" class="panel filtros"><label class="busqueda-label"><span class="sr-only">Buscar documentos</span><svg><use href="#i-buscar" /></svg><input id="busqueda-documentos" type="search" placeholder="Buscar por nombre o VIN…" /></label><label><span class="sr-only">Tipo de documento</span><select id="filtro-plantilla"><option value="">Selecciona el tipo de documento</option></select></label><button type="submit" class="boton secundario"><svg><use href="#i-buscar" /></svg>Buscar</button><button type="button" id="actualizar-documentos" class="boton-icono" title="Actualizar resultados con los mismos filtros" aria-label="Actualizar documentos"><svg><use href="#i-refresh" /></svg><span>Actualizar</span></button></form><div class="panel tabla-panel"><div class="tabla-cabecera"><h2>Documentos de tu agencia</h2><span id="total-documentos" class="muted"></span></div><div class="tabla-scroll"><table><thead><tr><th>Documento</th><th>Fecha y hora de creación</th><th>Firmas</th><th class="acciones-titulo">Acciones</th></tr></thead><tbody id="documentos-tabla"></tbody></table></div><div id="documentos-estado" class="vacio" role="status"></div><div class="paginacion"><span id="detalle-pagina" class="muted"></span><div><button id="pagina-anterior" class="boton secundario" disabled>Anterior</button><span id="pagina-actual">1</span><button id="pagina-siguiente" class="boton secundario" disabled>Siguiente</button></div></div></div></section>
                <section id="vista-actividad" hidden aria-label="Actividad"><div class="panel actividad-intro"><span class="icono-suave"><svg><use href="#i-reloj" /></svg></span><div><h2>El avance, sin perder el hilo</h2><p class="muted">Aquí ves las generaciones que iniciaste en esta sesión: en preparación, listas o pendientes de revisión. Si una generación falla, puedes volver a intentarla desde aquí. Los documentos existentes se consultan en Mis documentos.</p></div></div><div id="actividad-lista"></div><div id="actividad-vacia" class="vacio"><span class="vacio-icono"><svg><use href="#i-reloj" /></svg></span><h3>Todo listo para comenzar</h3><p>Aquí aparecerán los documentos que generes en esta sesión.</p><button class="boton secundario" data-vista="generar">Preparar una referencia</button></div></section>
            </main><footer class="pie-app">Firma V2 <span>Documentación clara. Seguimiento de principio a fin.</span></footer>
        </div>
    </div>
    <div id="avisos" class="avisos" aria-live="polite" aria-atomic="false"></div>
    <dialog id="modal-pdf" class="modal modal-pdf" aria-labelledby="titulo-pdf"><div class="modal-cabecera"><div><span class="eyebrow">VISTA DEL DOCUMENTO</span><h2 id="titulo-pdf">Documento</h2></div><button data-cerrar="modal-pdf" class="boton-icono" aria-label="Cerrar documento"><svg><use href="#i-cerrar" /></svg></button></div><div id="pdf-estado" class="modal-cuerpo" role="status"></div><iframe id="pdf-marco" title="Vista previa del documento PDF" hidden></iframe><div class="modal-pie"><a id="descargar-pdf" class="boton secundario" hidden download="documento.pdf">Descargar PDF</a><button data-cerrar="modal-pdf" class="boton secundario">Cerrar</button></div></dialog>
    <dialog id="modal-firmas" class="modal modal-grande" aria-labelledby="titulo-firmas"><div class="modal-cabecera"><div><span class="eyebrow">SEGUIMIENTO DEL EXPEDIENTE</span><h2 id="titulo-firmas">Firmas del documento</h2><p id="nombre-firmas" class="muted"></p></div><button data-cerrar="modal-firmas" class="boton-icono" aria-label="Cerrar firmas"><svg><use href="#i-cerrar" /></svg></button></div><div id="firmas-contenido" class="modal-cuerpo"></div><div class="modal-pie"><span id="firmas-mensaje" class="muted" role="status"></span><button data-cerrar="modal-firmas" class="boton secundario">Cerrar</button></div></dialog>

</div>

<dialog id="modal-seguro" class="modal" aria-labelledby="titulo-seguro">
 <div class="modal-cabecera"><h2 id="titulo-seguro">Seguro y conectividad</h2><button type="button" data-cerrar="modal-seguro" class="boton-icono" aria-label="Cerrar seguro">×</button></div>
 <div id="seguro-contenido" class="modal-cuerpo"></div>
 <div class="modal-pie"><button type="button" data-cerrar="modal-seguro" class="boton secundario">Cancelar</button><button type="button" id="guardar-seguro" class="boton primario">Guardar</button></div>
</dialog>
